# Copy this to .env and fill in your values. Never commit .env to source control.

# Database — use SQLite for local dev, Postgres/MySQL for production
DATABASE_URL=sqlite:///./sample.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_URL=mysql+pymysql://user:password@host:3306/dbname

# LLM Provider: openai | gemini | claude
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=                     # leave blank for provider default

# Safety
ENABLE_WRITE_MODE=false
ROW_LIMIT=100
QUERY_TIMEOUT=30

# CORS — comma-separated origins
ALLOWED_ORIGINS=["http://localhost:3000"]
# Production:
# ALLOWED_ORIGINS=["https://your-app.vercel.app"]
